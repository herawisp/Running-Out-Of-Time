MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1354619839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e7661a966e6e0949b8ccd856268edb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    sentences:
    - speakerAvatar: {fileID: 21300000, guid: 65624a3d9a0937047a996ff62f0e2ab0, type: 3}
      sentence: 'Di planner ini udah ada jadwal kuliah kamu, dimana kamu harus ke
        kelas sesuai jadwal, jangan telat atau bolos  ya

'
    - speakerAvatar: {fileID: 21300000, guid: 22e37ad593c9ed44099d6d03130ddffd, type: 3}
      sentence: Terus di samping kanan ini, ada list tugas-tugas kelas yang kamu
        harus selesain,
    - speakerAvatar: {fileID: 21300000, guid: 65624a3d9a0937047a996ff62f0e2ab0, type: 3}
      sentence: Nah untuk ini, kamu bisa click aja tugas tugas yang ada ke planner
        itu
    - speakerAvatar: {fileID: 21300000, guid: 65624a3d9a0937047a996ff62f0e2ab0, type: 3}
      sentence: Planner yang kita susun sekarang ini bakal jadi panduan buat keseharian
        kamu, jadi karena sekarang kamu bakal planning, pastiin bisa bener bener
        ditepati ya!
  dialogueManager: {fileID: 1886788475}
